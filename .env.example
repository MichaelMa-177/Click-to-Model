# Optional path overrides. Source this file from any directory.
_click_to_model_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export SPARK6D_REPO="${_click_to_model_root}/../SPARK-6D"
export SAM2_REPO="${SPARK6D_REPO}/third_party/sam2"
export SAM2_CHECKPOINT="${SAM2_REPO}/checkpoints/sam2.1_hiera_small.pt"
export SAM3D_REPO="${_click_to_model_root}/sam-3d-objects"
export SAM3D_CHECKPOINT_DIR="${SAM3D_REPO}/checkpoints/hf"
export SAM3D_DINO_REPO="${_click_to_model_root}/dinov2"
export SAM3D_DINO_SKIP_WEIGHTS=1

unset _click_to_model_root
